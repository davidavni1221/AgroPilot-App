[Unit]
Description=AgroPilot weather-service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/AgroPilot-App/services/weather-service
ExecStart=/home/ubuntu/AgroPilot-App/services/weather-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8001
Restart=on-failure

[Install]
WantedBy=multi-user.target
