# Copy this file to .env. Every variable except PROVIDER_API_KEY is required:
# the service refuses to start if one is missing.

# The forecast provider. The free Open-Meteo tier needs no key.
# For a paid plan: PROVIDER_BASE_URL=https://customer-api.open-meteo.com/v1/forecast and set PROVIDER_API_KEY.
PROVIDER_BASE_URL=https://api.open-meteo.com/v1/forecast
PROVIDER_API_KEY=
PROVIDER_TIMEOUT_SECONDS=5
# Extra attempts after the first one fails (2 means up to 3 calls).
PROVIDER_RETRIES=2

# A forecast younger than this is served without calling the provider (3 hours).
FORECAST_FRESH_SECONDS=10800
# When the provider is down, a forecast up to this old is still served, marked stale (24 hours).
FORECAST_MAX_STALE_SECONDS=86400
# Value of the Retry-After header on a 503.
RETRY_AFTER_SECONDS=60
