# Copy this file to .env.local and adjust the addresses.
# These are read on the server only. The browser never calls the services.
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_URL=http://127.0.0.1:8001
PLANNER_URL=http://127.0.0.1:8002

# Only for adding components from shadcn.io with the shadcn CLI. Not needed to run the app.
# SHADCNIO_TOKEN=
