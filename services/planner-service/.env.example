# Copy this file to .env. Every variable is required: the service refuses to start if one is missing.

# The other services, reached over HTTP only.
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_URL=http://127.0.0.1:8001

# Timeout of one call to another service. The weather-service may itself retry the provider,
# so give it more time than the registry.
REGISTRY_TIMEOUT_SECONDS=3
WEATHER_TIMEOUT_SECONDS=20
