[Unit]
Description=AgroPilot planner-service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/AgroPilot-App/services/planner-service
ExecStart=/home/ubuntu/AgroPilot-App/services/planner-service/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8002
Restart=on-failure

[Install]
WantedBy=multi-user.target
