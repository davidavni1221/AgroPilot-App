# Copy this file to .env and fill in the values. Leave DATABASE_URL unset to use SQLite.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Plot photos are stored in this S3 bucket. Never put AWS keys here: boto3 finds them by itself.
AWS_S3_BUCKET=your-name-agropilot-photos
AWS_REGION=eu-north-1
